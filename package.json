{
  "name": "molren",
  "version": "0.1.0",
  "description": "Render 2D chemical structures from SMILES in Obsidian notes, powered by RDKit.js.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "chemistry",
    "smiles",
    "rdkit",
    "molecule"
  ],
  "author": "Josh",
  "license": "MIT",
  "dependencies": {
    "@rdkit/rdkit": "^2025.3.4-1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
